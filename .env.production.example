# Production deployment template for 智学领航 / Evidence-First Learning Agent.
#
# Usage:
#   cp .env.production.example .env.production
#   # replace every REPLACE_WITH_* value; never commit .env.production
#   docker compose --env-file .env.production -f docker-compose.production.yml config
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
#
# The backend starts with APP_ENV=production, so validate_deployment() fails
# closed until all required values are real (no placeholder passwords/keys,
# CORS must be https, database password 12+ characters). This file has NOT been
# validated against a running Docker engine in the current workspace; the
# compose config is validated offline with the command above.

# --- Database (internal only; no host port is published) ---
POSTGRES_USER=triple_u
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
POSTGRES_DB=triple_u

# --- Phoenix observability database (internal only) ---
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
PHOENIX_DB=phoenix
# Pin a reviewed Phoenix image tag before a real deployment.
PHOENIX_IMAGE=arizephoenix/phoenix:latest

# --- Model provider (required; placeholder values fail startup validation) ---
LLM_PROVIDER=deepseek
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=REPLACE_WITH_MODEL_API_KEY
OPENAI_MODEL=deepseek-flash

# --- Browser origin allowed to call the API (must be https) ---
A3_CORS_ORIGINS=https://REPLACE_WITH_YOUR_HTTPS_DOMAIN

# --- Frontend bind (loopback by default; put TLS/reverse proxy in front) ---
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5173
