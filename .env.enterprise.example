# Local Docker enterprise stack. Copy to .env.enterprise and change passwords.
POSTGRES_USER=triple_u
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=triple_u
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=change-me-local-phoenix
PHOENIX_DB=phoenix

DATABASE_URL=postgresql+psycopg://triple_u:change-me-local@postgres:5432/triple_u
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_INGEST_ENABLED=true
LANGGRAPH_STRICT_MSGPACK=true

V2_AUTH_REQUIRED=true
V2_STUDENT_COURSES=artificial_intelligence
V2_TEACHER_COURSES=artificial_intelligence
V2_COURSE_AUTH_MODE=environment
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006/v1/traces

# --- Per-user/course quotas (QWEN-324; enabled for the enterprise stack) ---
# Sliding windows: requests per user/minute, tokens per user+course/hour,
# measured cost per user/day (unknown-cost runs never count as zero).
QUOTA_ENABLED=true
QUOTA_REQUESTS_PER_MINUTE=60
QUOTA_TOKENS_PER_HOUR=500000
QUOTA_COST_CNY_PER_DAY=5.0

# Offline by default. Set false only after configuring provider credentials.
A3_OFFLINE_DEMO=true
LLM_PROVIDER=none
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16
