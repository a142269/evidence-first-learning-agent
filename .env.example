# Offline-first local development. Copy to .env and keep the result private.
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
DEFAULT_COURSE=artificial_intelligence

# No paid model calls in the default configuration.
A3_OFFLINE_DEMO=true
LLM_PROVIDER=none
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=300

# Local persistence and retrieval.
DATABASE_URL=sqlite:///./data/a3.db
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/vector_store
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
RAG_TOP_K=5
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=200
KNOWLEDGE_BASE_PATH=./knowledge_base

# Optional services.
AGENT_V2_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CELERY_INGEST_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional providers. Leave blank unless the corresponding feature is used.
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=
XUNFEI_TTS_APP_ID=
XUNFEI_TTS_API_KEY=
XUNFEI_TTS_API_SECRET=
